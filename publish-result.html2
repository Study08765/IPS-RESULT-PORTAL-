<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Publish Results | CBT Admin</title>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>

/* =========================
   GLOBAL
========================= */

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

body{
min-height:100vh;
padding:22px;

background:
radial-gradient(circle at 10% 10%,rgba(37,99,235,.10),transparent 30%),
radial-gradient(circle at 90% 20%,rgba(124,58,237,.08),transparent 30%),
linear-gradient(135deg,#f8fbff,#eef4ff);

color:#1e293b;
}

.container{
width:100%;
max-width:1200px;
margin:auto;
}


/* =========================
   HERO HEADER
========================= */

.page-header{
position:relative;
overflow:hidden;

background:
linear-gradient(135deg,#0f3d91 0%,#2563eb 55%,#4f46e5 100%);

padding:24px 26px;
border-radius:22px;

display:flex;
align-items:center;
gap:16px;

color:#fff;

margin-bottom:20px;

box-shadow:
0 15px 35px rgba(37,99,235,.25);
}

.page-header::before{
content:"";
position:absolute;

width:180px;
height:180px;

border-radius:50%;

background:rgba(255,255,255,.09);

top:-100px;
right:-40px;
}

.page-header::after{
content:"";

position:absolute;

width:100px;
height:100px;

border-radius:50%;

background:rgba(255,255,255,.07);

bottom:-60px;
right:130px;
}

.header-icon{
width:58px;
height:58px;

flex-shrink:0;

border-radius:17px;

background:rgba(255,255,255,.17);

border:1px solid rgba(255,255,255,.22);

display:flex;
align-items:center;
justify-content:center;

font-size:29px;

box-shadow:
inset 0 1px 1px rgba(255,255,255,.25);

position:relative;
z-index:2;
}

.header-text{
position:relative;
z-index:2;
}

.page-header h1{
font-size:26px;
font-weight:800;
color:#fff;
margin:0;
line-height:1.2;
}

.page-header p{
font-size:13px;
font-weight:500;
opacity:.85;
margin-top:5px;
}


/* =========================
   STATS
========================= */

.stats{
display:grid;

grid-template-columns:
repeat(4,1fr);

gap:15px;

margin-bottom:22px;
}

.stat-card{
position:relative;
overflow:hidden;

color:#fff;

padding:21px 18px;

border-radius:18px;

box-shadow:
0 10px 25px rgba(15,23,42,.13);

border:
1px solid rgba(255,255,255,.25);

transition:
transform .25s ease,
box-shadow .25s ease;
}

.stat-card:hover{
transform:translateY(-3px);

box-shadow:
0 15px 30px rgba(15,23,42,.17);
}

.stat-card::after{
content:"";

position:absolute;

width:100px;
height:100px;

border-radius:50%;

background:
rgba(255,255,255,.11);

top:-40px;
right:-28px;
}

.stat-card:nth-child(1){
background:
linear-gradient(135deg,#2563eb,#1e40af);
}

.stat-card:nth-child(2){
background:
linear-gradient(135deg,#16a34a,#059669);
}

.stat-card:nth-child(3){
background:
linear-gradient(135deg,#7c3aed,#9333ea);
}

.stat-card:nth-child(4){
background:
linear-gradient(135deg,#ef4444,#dc2626);
}

.stat-card h2{
position:relative;
z-index:2;

font-size:32px;
font-weight:800;

line-height:1;

margin-bottom:9px;
}

.stat-card p{
position:relative;
z-index:2;

font-size:13px;
font-weight:600;

opacity:.9;
}


/* =========================
   SECTION TITLE
========================= */

.section-heading{
display:flex;
align-items:center;
justify-content:space-between;

margin:5px 3px 12px;
}

.section-heading h2{
font-size:19px;
font-weight:800;
color:#172554;
}

.live-badge{
display:inline-flex;
align-items:center;
gap:6px;

font-size:11px;
font-weight:700;

padding:6px 10px;

border-radius:30px;

background:#dcfce7;
color:#15803d;

border:1px solid #bbf7d0;
}

.live-dot{
width:7px;
height:7px;

border-radius:50%;

background:#22c55e;

box-shadow:
0 0 0 4px rgba(34,197,94,.12);
}


/* =========================
   SWIPE HINT
========================= */

.swipe-hint{
display:none;

font-size:11px;
font-weight:600;

color:#64748b;

text-align:right;

margin:
0 5px 7px;
}


/* =========================
   TABLE WRAPPER
========================= */

.table-wrapper{
width:100%;

overflow-x:auto;

border-radius:19px;

background:#fff;

border:
1px solid #e5eaf3;

box-shadow:
0 12px 35px rgba(15,23,42,.09);

-webkit-overflow-scrolling:touch;
}


/* =========================
   TABLE
========================= */

table{
width:100%;
min-width:850px;

border-collapse:separate;
border-spacing:0;

background:#fff;
}

th{
padding:16px 12px;

border:none;

background:
linear-gradient(135deg,#0f3d91,#2563eb);

color:#fff;

font-size:13px;
font-weight:700;

letter-spacing:.2px;

text-align:center;
}

td{
padding:14px 12px;

border:none;

border-bottom:
1px solid #edf2f7;

text-align:center;

font-size:13px;
font-weight:500;

color:#334155;
}

tbody tr{
transition:
background .2s ease;
}

tbody tr:hover{
background:#f5f9ff;
}

tbody tr:last-child td{
border-bottom:none;
}


/* =========================
   STATUS BADGES
========================= */

.status{
display:inline-flex;

align-items:center;
justify-content:center;

padding:6px 11px;

border-radius:30px;

font-size:11px;
font-weight:700;

white-space:nowrap;
}

.status-published{
background:#dcfce7;
color:#15803d;

border:
1px solid #bbf7d0;
}

.status-hidden{
background:#fee2e2;
color:#dc2626;

border:
1px solid #fecaca;
}


/* =========================
   BUTTONS
========================= */

.action-btn{
padding:8px 12px;

border:none;

border-radius:9px;

font-size:11px;
font-weight:700;

cursor:pointer;

margin:3px;

transition:
all .25s ease;

color:#fff;

white-space:nowrap;

box-shadow:
0 4px 10px rgba(15,23,42,.15);
}

.result-btn{
background:
linear-gradient(135deg,#16a34a,#22c55e);
}

.key-btn{
background:
linear-gradient(135deg,#2563eb,#3b82f6);
}

.action-btn:hover{
transform:
translateY(-2px);

box-shadow:
0 7px 15px rgba(15,23,42,.20);
}

.action-btn:active{
transform:scale(.96);
}


/* =========================
   MOBILE
========================= */

@media(max-width:700px){

body{
padding:12px;
}

.page-header{
padding:18px;
border-radius:17px;
gap:12px;
}

.header-icon{
width:50px;
height:50px;

font-size:25px;

border-radius:14px;
}

.page-header h1{
font-size:20px;
}

.page-header p{
font-size:11px;
}

.stats{
grid-template-columns:
repeat(2,1fr);

gap:10px;

margin-bottom:18px;
}

.stat-card{
padding:16px 11px;

border-radius:14px;
}

.stat-card h2{
font-size:25px;
}

.stat-card p{
font-size:10px;
}

.section-heading h2{
font-size:16px;
}

.live-badge{
font-size:9px;
padding:5px 8px;
}

.swipe-hint{
display:block;
}

.table-wrapper{
border-radius:15px;
}

th{
font-size:11px;
padding:13px 10px;
}

td{
font-size:11px;
padding:12px 10px;
}

}


/* =========================
   EXTRA SMALL MOBILE
========================= */

@media(max-width:380px){

body{
padding:9px;
}

.page-header h1{
font-size:18px;
}

.stats{
gap:8px;
}

.stat-card{
padding:14px 8px;
}

.stat-card h2{
font-size:23px;
}

}

</style>
</head>


<body>

<div class="container">


<!-- HERO HEADER -->

<div class="page-header">

<div class="header-icon">
🏆
</div>

<div class="header-text">

<h1>Publish Results</h1>

<p>
Manage CBT Results & Answer Keys
</p>

</div>

</div>



<!-- STATISTICS -->

<div class="stats">

<div class="stat-card">

<h2 id="totalTests">
0
</h2>

<p>
Total Tests
</p>

</div>


<div class="stat-card">

<h2 id="publishedResults">
0
</h2>

<p>
Published Results
</p>

</div>


<div class="stat-card">

<h2 id="publishedKeys">
0
</h2>

<p>
Published Keys
</p>

</div>


<div class="stat-card">

<h2 id="hiddenResults">
0
</h2>

<p>
Hidden Results
</p>

</div>

</div>



<!-- SECTION HEADING -->

<div class="section-heading">

<h2>
CBT Test Management
</h2>

<div class="live-badge">

<span class="live-dot"></span>

LIVE

</div>

</div>



<!-- MOBILE SWIPE MESSAGE -->

<div class="swipe-hint">
👈 Swipe to view full table 👉
</div>



<!-- TABLE -->

<div class="table-wrapper">

<table>

<thead>

<tr>

<th>Test</th>

<th>Class</th>

<th>Subject</th>

<th>Result</th>

<th>Answer Key</th>

<th>Action</th>

</tr>

</thead>


<tbody id="testList">

</tbody>

</table>

</div>


</div>



<script type="module">

import { db }
from "./firebase.js";


import {

collection,
onSnapshot,
doc,
updateDoc

} from "https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore.js";



const list =
document.getElementById("testList");



onSnapshot(
collection(db,"cbtTests"),
(snapshot)=>{


list.innerHTML = "";


let total = 0;

let published = 0;

let keys = 0;



snapshot.forEach((document)=>{


const x =
document.data();


total++;


if(x.resultPublished)
published++;


if(x.answerKeyPublished)
keys++;



list.innerHTML += `

<tr>


<td>
${x.testName || "-"}
</td>


<td>
${x.className || "-"}
</td>


<td>
${x.subject || "-"}
</td>



<td>

<span class="status ${
x.resultPublished
? "status-published"
: "status-hidden"
}">

${
x.resultPublished
? "✓ Published"
: "● Hidden"
}

</span>

</td>



<td>

<span class="status ${
x.answerKeyPublished
? "status-published"
: "status-hidden"
}">

${
x.answerKeyPublished
? "✓ Published"
: "● Hidden"
}

</span>

</td>



<td>


<button
class="action-btn result-btn"
onclick="toggleResult('${document.id}')">

${
x.resultPublished
? "🔴 Hide Result"
: "🟢 Publish Result"
}

</button>



<button
class="action-btn key-btn"
onclick="toggleKey('${document.id}')">

${
x.answerKeyPublished
? "🔒 Hide Key"
: "🔑 Publish Key"
}

</button>


</td>


</tr>

`;

});


document.getElementById(
"totalTests"
).textContent =
total;


document.getElementById(
"publishedResults"
).textContent =
published;


document.getElementById(
"publishedKeys"
).textContent =
keys;


document.getElementById(
"hiddenResults"
).textContent =
total - published;


});



/* =========================
   RESULT PUBLISH / HIDE
========================= */

window.toggleResult =
async(id)=>{


const button =
[...document.querySelectorAll(
".result-btn"
)].find(

btn =>
btn.getAttribute("onclick") ===
`toggleResult('${id}')`

);


if(!button)
return;


const current =
button.textContent.includes("Hide");


button.disabled = true;


try{


await updateDoc(

doc(
db,
"cbtTests",
id
),

{

resultPublished:
!current

}

);


}catch(error){


console.error(error);


alert(
"Unable to update result."
);


}finally{


button.disabled = false;


}


};



/* =========================
   ANSWER KEY PUBLISH / HIDE
========================= */

window.toggleKey =
async(id)=>{


const button =
[...document.querySelectorAll(
".key-btn"
)].find(

btn =>
btn.getAttribute("onclick") ===
`toggleKey('${id}')`

);


if(!button)
return;


const current =
button.textContent.includes("Hide");


button.disabled = true;


try{


await updateDoc(

doc(
db,
"cbtTests",
id
),

{

answerKeyPublished:
!current

}

);


}catch(error){


console.error(error);


alert(
"Unable to update answer key."
);


}finally{


button.disabled = false;


}


};


</script>

</body>
  </html>
